# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here   # NEVER expose as NEXT_PUBLIC_

# ─── Site URL ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_ELITE_PRICE_ID=price_...

# ─── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456789:ABCdef...
TELEGRAM_VIP_PRO_CHANNEL_ID=-100...     # negative number for supergroups
TELEGRAM_VIP_ELITE_CHANNEL_ID=-100...

# ─── MT5 / MetaAPI ───────────────────────────────────────────────────────────
METAAPI_TOKEN=your-metaapi-token
METAAPI_DOMAIN=agiliumtrade.agiliumtrade.ai   # default MetaAPI domain

# ─── AI Engine (Anthropic Claude for SMC analysis) ───────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Optional ────────────────────────────────────────────────────────────────
# OpenAI fallback (if not using Anthropic)
OPENAI_API_KEY=sk-proj-...
