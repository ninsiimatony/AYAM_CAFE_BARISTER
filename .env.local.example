# ─── Supabase ────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Site URL ────────────────────────────────────────────────────────────────
# REQUIRED in production — must match your Vercel/domain URL exactly
# Used for: Server Actions allowedOrigins, auth email redirects
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# ─── OpenAI ──────────────────────────────────────────────────────────────────
# Required for Barista Bot AI responses.
# Get your key from: https://platform.openai.com/api-keys
# If missing, the chat will use a static fallback message.
OPENAI_API_KEY=sk-proj-your-openai-key-here

# ─── Optional ────────────────────────────────────────────────────────────────
# Shows "configured" badge in admin panel
NEXT_PUBLIC_OPENAI_CONFIGURED=true
