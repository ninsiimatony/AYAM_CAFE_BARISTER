# ============================================================
# TONY ELITE AI — Environment Variables
# Copy this file to .env.local and fill in all values.
# NEVER commit .env.local to version control.
# ============================================================

# ─── Supabase ─────────────────────────────────────────────────────────────────
# From: https://supabase.com/dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Service role key — NEVER prefix with NEXT_PUBLIC_. Server-side API routes only.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ─── Stripe ───────────────────────────────────────────────────────────────────
# From: https://dashboard.stripe.com → Developers → API keys

STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Webhook secret — from: Stripe Dashboard → Webhooks → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs — from: Stripe Dashboard → Products → Prices
# Create two recurring prices: Pro ($29/mo) and Elite ($99/mo)
STRIPE_PRO_PRICE_ID=price_...
STRIPE_ELITE_PRICE_ID=price_...

# ─── Anthropic (AI Signal Analysis) ──────────────────────────────────────────
# From: https://console.anthropic.com → API Keys

ANTHROPIC_API_KEY=sk-ant-...

# ─── Telegram Bot ─────────────────────────────────────────────────────────────
# 1. Create a bot via @BotFather → /newbot → copy the token
# 2. Add the bot as admin to your VIP channels
# 3. Get channel IDs (negative numbers for supergroups, e.g. -1001234567890)

TELEGRAM_BOT_TOKEN=1234567890:AABBCCDDEEFFaabbccddeeff-1234567890

# Bot username WITHOUT the @ symbol — shown in deep-link URLs on the Telegram linking page
TELEGRAM_BOT_USERNAME=tonyeliteai_bot

# VIP channel IDs (negative for supergroups)
TELEGRAM_VIP_PRO_CHANNEL_ID=-1001234567890
TELEGRAM_VIP_ELITE_CHANNEL_ID=-1009876543210

# Secret token for webhook verification (any random 32+ char string)
TELEGRAM_WEBHOOK_SECRET=your_random_secret_token_here

# ─── MetaAPI (MT5 Integration — Elite tier) ───────────────────────────────────
# From: https://metaapi.cloud → Dashboard → API token

METAAPI_TOKEN=your_metaapi_token

# ─── Application ──────────────────────────────────────────────────────────────
# Production URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# OpenAI (legacy café chatbot feature — can be omitted)
OPENAI_API_KEY=sk-...
